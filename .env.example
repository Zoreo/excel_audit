# All settings are optional; defaults shown below.

# Directory for the SQLite job store and transient upload scratch space.
EXCEL_AUDITOR_DATA_DIR=./data

# Directory for stored reports (served at {BASE_URL}/reports/{id}).
EXCEL_AUDITOR_ARTIFACTS_DIR=./artifacts

# Base URL used when printing report links (where `excel-auditor serve` runs).
EXCEL_AUDITOR_BASE_URL=http://localhost:8000

# Upload / decompression safety limits.
EXCEL_AUDITOR_MAX_UPLOAD_MB=25
EXCEL_AUDITOR_MAX_DECOMPRESSED_MB=250
EXCEL_AUDITOR_MAX_ZIP_ENTRIES=10000
EXCEL_AUDITOR_MAX_ZIP_RATIO=200

# Dependency graph safety cap: ranges larger than this many cells are truncated.
EXCEL_AUDITOR_MAX_RANGE_CELLS=10000

EXCEL_AUDITOR_LOG_LEVEL=INFO
