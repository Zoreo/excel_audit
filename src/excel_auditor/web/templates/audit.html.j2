{% extends "_layout.html.j2" %}
{% block title %}Audit a workbook{% endblock %}
{% block content %}
<h1>Audit one workbook</h1>
<form action="/audit" method="post" enctype="multipart/form-data">
  <label for="file">Workbook (.xlsx / .xlsm)</label>
  <input type="file" id="file" name="file" accept=".xlsx,.xlsm" required>
  <button type="submit">Run audit</button>
</form>
{% endblock %}
