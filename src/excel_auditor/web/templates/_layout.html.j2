<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Excel Auditor{% endblock %}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         max-width: 640px; margin: 48px auto; padding: 0 20px; color: #1a2333; line-height: 1.5; }
  h1 { font-size: 22px; }
  nav a { margin-right: 14px; }
  form { margin: 20px 0; padding: 16px; border: 1px solid #d9dee6; border-radius: 8px; }
  label { display: block; margin: 10px 0 4px; font-weight: 600; font-size: 14px; }
  input[type=text] { width: 100%; padding: 6px 8px; }
  button { margin-top: 12px; padding: 8px 18px; }
  .error { color: #b91c1c; }
  .muted { color: #5b6472; font-size: 13px; }
  ol li { margin: 4px 0; }
</style>
</head>
<body>
<nav>
  <a href="/">Home</a>
  <a href="/audit">Audit</a>
  <a href="/compare">Compare</a>
  <a href="/ask">Ask</a>
</nav>
{% block content %}{% endblock %}
<p class="muted">Local demonstration interface. Reports are stored under artifacts/ and
served at /reports/{id}; production use requires authentication.</p>
</body>
</html>
